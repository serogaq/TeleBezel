{
  "name": "telebezel-app",
  "author": "TeleBezel contributors",
  "version": "0.3.0",
  "description": "Modern Pebble Telegram client",
  "keywords": [
    "pebble-app",
    "telegram"
  ],
  "private": true,
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "generate": "node scripts/generate.js",
    "lint": "eslint src/pkjs tests scripts",
    "test:js": "node tests/run.js",
    "test:c": "node tests/c.js",
    "test:e2e": "node tests/e2e/read_path.js",
    "test": "npm run generate && npm run lint && npm run test:js && npm run test:c && npm run test:e2e"
  },
  "dependencies": {
    "@rebble/clay": "1.1.0"
  },
  "devDependencies": {
    "eslint": "10.10.0"
  },
  "pebble": {
    "displayName": "TeleBezel",
    "uuid": "b91f715e-af74-4a90-9df4-fda0fbcd9762",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "diorite",
      "emery",
      "flint",
      "gabbro"
    ],
    "capabilities": [
      "configurable"
    ],
    "watchapp": {
      "watchface": false
    },
    "messageKeys": [
      "REQUEST_KIND",
      "REQUEST_SEQ",
      "RESPONSE_KIND",
      "RESULT_CODE",
      "INBOX_SIZE",
      "PAYLOAD",
      "ENTITY_ID",
      "CHUNK_INDEX",
      "CHUNK_TOTAL",
      "CONFIG_ADDRESS",
      "CONFIG_SSL",
      "CONFIG_TOKEN",
      "ACCOUNT_ID",
      "MESSAGE_ID",
      "PAGE_OP",
      "LIST",
      "PAGE_LIMIT",
      "TEXT_LIMIT",
      "PAGE_FLAGS",
      "RETRY_AFTER"
    ],
    "resources": {
      "media": []
    }
  }
}
